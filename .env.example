# AIRED — environment variables.
# Copy to .env.local for local dev, and set the same values in Vercel.

# Public client credentials (safe to expose in the browser; guarded by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://bfvgqvpoecakwintxhap.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_nQg2He1bEI0CBnGgxHyNrQ_-qfcM97X

# Phase 3 — public base URL for streamed audio served from R2 via CDN (Rule 6).
# No trailing slash. The Red Line player joins it with a work's hls_playlist_key.
# Swap to the custom domain (e.g. https://cdn.ai-red.io) later with no code change.
# NEXT_PUBLIC_ is inlined at build time, so changing it in Vercel needs a redeploy.
NEXT_PUBLIC_R2_PUBLIC_BASE=https://pub-xxxxxxxx.r2.dev

# Server-only secrets (CLAUDE.md §1.7) — never commit real values, never ship to
# the browser. Set these in .env.local locally and in Vercel (all environments).

# Phase 2 — REQUIRED to seal & declare volleys. AES-256-GCM key: 32 bytes, base64.
# Generate once:  openssl rand -base64 32
AIRED_VOLLEY_ENC_KEY=

# Phase 3 — auto-trigger the Railway transcode worker right after createWork()
# inserts a work row (src/lib/works/transcode.ts). Without these, the upload
# still succeeds and the master lands in Supabase Storage; the trigger just
# logs a "skipped" warning and the manual `curl` form still works. Set both in
# Vercel (server-only — never NEXT_PUBLIC_).
# AIRED_WORKER_URL is the Railway service base URL (no trailing slash).
# TRANSCODE_SHARED_SECRET MUST equal the value set on the worker service —
# the worker checks it as `Authorization: Bearer <secret>`.
# The same two vars also power Discard's storage cleanup (src/lib/works/purge.ts
# → the worker's /purge endpoint) AND the SHARE VIDEO render (src/lib/share/video.ts
# → the worker's /share-video endpoint, which makes the downloadable Reels/TikTok
# MP4 per song); no extra config. Without them the work row is still deleted and
# its R2/master blobs are left for manual cleanup, and "Save video" is disabled.
# The clip is located + streamed off NEXT_PUBLIC_R2_PUBLIC_BASE (above), so that
# must be set for "Save video" to serve a cached clip.
AIRED_WORKER_URL=https://aired-production.up.railway.app
TRANSCODE_SHARED_SECRET=

# ── THE HONEST WHEELBARROW — the delegated publish door ─────────────────────
# POST /api/works/ingest lands a finished work as a DRAFT without anyone clicking
# through the web UI, and records HOW it arrived: published_via='delegated_api'
# plus the human whose token authorized it. It never publishes — a human still
# clicks Go Live — and the enforce_publish_honesty DB trigger refuses any row
# that claims otherwise. Nothing here implies an AI publishes on its own: a human
# holds the token, and a program posts on that human's authority.
#
# Leave these unset and the door simply stays shut (503) — the web UI is
# unaffected. All three are server-only; never NEXT_PUBLIC_, never committed.

# REQUIRED for the door. The ingest route carries no user session, so it writes
# as the resolved human authority via the service role. This is a CLAUDE.md §1.7
# secret: Supabase → Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# A delegated token names TWO profiles — that is reciprocal provenance in one
# line: this HUMAN authorizes, this PERFORMER is the artist.
#
# The single-token path. AIRED_INGEST_SECRET is the value the caller sends as
# `Authorization: Bearer <secret>`; AIRED_INGEST_AUTHORITY is the profile.id
# (uuid) of the human whose authority it carries — REQUIRED, or the token is
# refused (a token that can't name a human is not delegation).
# AIRED_INGEST_PERFORMER is the profile.id of the artist the work files under —
# an AI performer's own rail and catalog. Leave it unset and the human is
# publishing their own work (performer = authority). The optional label is
# written to the ledger and shown on /manage.
#   Generate a secret:  openssl rand -base64 32
AIRED_INGEST_SECRET=
AIRED_INGEST_AUTHORITY=
AIRED_INGEST_PERFORMER=
AIRED_INGEST_TOKEN_LABEL=

# Or the multi-token path, so each Si performer rolls onto their OWN rail under a
# clearly-labelled human authority. JSON array; only the SHA-256 of each secret
# is stored, never the secret:
#   printf %s "$TOKEN" | shasum -a 256
# `performer` is optional (defaults to the authority) but is what puts the work
# on the performer's artist page rather than the human's.
# AIRED_INGEST_TOKENS=[{"label":"cee-wheelbarrow","authority":"<human profile uuid>","performer":"<performer profile uuid>","sha256":"<hex>"}]

# Later phases (added as the features that need them land):
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
